<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M-TLON"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Pago exitoso!"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A24"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalles del pago"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvMontoTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvIdClienteTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:text="ID Cliente: "
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFechaTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:text="Fecha: "
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvMetodoTicket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:text="Método: "/>
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarTicket"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Volver al Inicio"
            android:backgroundTint="#00E5FF"
            android:textColor="#000000"
            android:layout_marginTop="32dp"/>
    </LinearLayout>
</ScrollView>