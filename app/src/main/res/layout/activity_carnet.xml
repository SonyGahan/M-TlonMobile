<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M-TLON"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <!-- Tarjeta de Socio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A24"
        android:padding="24dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARNET SOCIO"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvNombreCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDniCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNI: "
            android:textColor="#E0E0E0"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvEmailCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: "
            android:textColor="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A35"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvVencimientoCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vence: --/--/----"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverDeCarnet"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Volver al Inicio"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"/>

</LinearLayout>