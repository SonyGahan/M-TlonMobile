<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/m_tlon"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A24"
        android:padding="24dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carnet_socio"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvNombreCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_apellido"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDniCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dni"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvEmailCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A35"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvVencimientoCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vence"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnImprimirCarnet"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Imprimir Carnet"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginTop="32dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnVolverDeCarnet"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Atrás"
        android:backgroundTint="#2A2A35"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnInicioDeCarnet"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/volver_al_inicio"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"/>

</LinearLayout>