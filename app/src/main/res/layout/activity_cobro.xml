<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A24"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A2A35"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvNombreCompleto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre y Apellido"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvDniCobro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DNI: "
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvEmailCobro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: "
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTelefonoCobro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teléfono: "
            android:textColor="#E0E0E0"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A2A35"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto cuota"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etMonto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1A1A24"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo de pago"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/spModoPago"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#2A2A35"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRegistrarPago"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Registrar pago"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnVolverMenu"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Volver al Inicio"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF"/>

</LinearLayout>